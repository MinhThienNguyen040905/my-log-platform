Project mylog {
  database_type: 'PostgreSQL'
  Note: 'Logical schema v1. Sensitive payloads are envelope-encrypted by the application.'
}

Table users {
  id uuid [pk]
  email_lookup_hash bytea [not null, note: 'Partial unique where deleted_at IS NULL in Flyway V2']
  encrypted_email bytea [not null]
  email_iv bytea [not null]
  email_wrapped_key bytea [not null]
  email_key_version varchar(32) [not null]
  password_hash varchar(255)
  auth_provider varchar(32) [not null]
  status varchar(24) [not null]
  email_verified_at timestamptz
  last_login_at timestamptz
  failed_login_count integer [not null, default: 0]
  locked_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  row_version bigint [not null, default: 0]
}

Table user_profiles {
  user_id uuid [pk, ref: > users.id]
  encrypted_profile bytea [not null]
  profile_iv bytea [not null]
  profile_wrapped_key bytea [not null]
  profile_key_version varchar(32) [not null]
  timezone varchar(64) [not null]
  locale varchar(10) [not null]
  onboarding_completed_at timestamptz
  preferred_journal_time time
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null, default: 0]
}

Table user_consents {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  consent_type varchar(40) [not null]
  document_version varchar(40) [not null]
  granted boolean [not null]
  decided_at timestamptz [not null]
  source varchar(24) [not null]

  indexes {
    (user_id, consent_type, decided_at)
  }
}

Table roles {
  id uuid [pk]
  code varchar(60) [not null, unique]
  name varchar(120) [not null]
  description varchar(500)
  system_role boolean [not null, default: false]
  created_at timestamptz [not null]
}

Table permissions {
  id uuid [pk]
  code varchar(100) [not null, unique]
  description varchar(500)
  created_at timestamptz [not null]
}

Table role_permissions {
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]
  created_at timestamptz [not null]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_roles {
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  assigned_by uuid [ref: > users.id]
  assigned_at timestamptz [not null]
  expires_at timestamptz

  indexes {
    (user_id, role_id) [pk]
  }
}

Table auth_sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  current_token_hash bytea [not null, unique]
  token_family_id uuid [not null]
  device_name varchar(120)
  user_agent_hash bytea
  ip_prefix inet
  last_used_at timestamptz [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason varchar(40)
  created_at timestamptz [not null]
}

Table auth_refresh_history {
  id uuid [pk]
  token_hash bytea [not null, unique]
  session_id uuid [not null, ref: > auth_sessions.id]
  used_at timestamptz [not null]
}

Table auth_action_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_hash bytea [not null, unique]
  purpose varchar(32) [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null]
}

Table auth_rate_limits {
  subject_hash bytea [pk]
  attempts integer [not null]
  window_started_at timestamptz [not null]
  blocked_until timestamptz
}

Table journal_entries {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  encrypted_payload bytea [not null]
  payload_iv bytea [not null]
  wrapped_data_key bytea [not null]
  encryption_key_version varchar(32) [not null]
  content_format_version smallint [not null]
  occurred_at timestamptz [not null]
  local_date date [not null]
  timezone varchar(64) [not null]
  mood_code varchar(32)
  mood_score numeric(3,1)
  stress_score numeric(3,1)
  energy_score numeric(3,1)
  sleep_minutes smallint
  favorite boolean [not null, default: false]
  entry_status varchar(24) [not null]
  risk_level varchar(16) [not null]
  analysis_status varchar(32) [not null]
  content_version integer [not null, default: 1]
  latest_analysis_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  row_version bigint [not null, default: 0]

  indexes {
    (user_id, occurred_at)
    (user_id, local_date)
  }
}

Table journal_tags {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  name_lookup_hash bytea [not null]
  encrypted_name bytea [not null]
  name_iv bytea [not null]
  name_wrapped_key bytea [not null]
  name_key_version varchar(32) [not null]
  color varchar(9)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, name_lookup_hash) [unique]
  }
}

Table journal_entry_tags {
  journal_entry_id uuid [not null, ref: > journal_entries.id]
  tag_id uuid [not null, ref: > journal_tags.id]
  created_at timestamptz [not null]

  indexes {
    (journal_entry_id, tag_id) [pk]
  }
}

Table journal_assets {
  id uuid [pk]
  journal_entry_id uuid [not null, ref: > journal_entries.id]
  user_id uuid [not null, ref: > users.id]
  provider_asset_id varchar(255) [not null, unique]
  public_id varchar(512) [not null, unique]
  provider_version bigint [not null]
  format varchar(32) [not null]
  delivery_type varchar(32) [not null]
  asset_type varchar(24) [not null]
  mime_type varchar(120) [not null]
  size_bytes bigint [not null]
  sha256 bytea [not null]
  status varchar(24) [not null]
  encrypted_caption bytea
  caption_iv bytea
  caption_wrapped_key bytea
  caption_key_version varchar(32)
  created_at timestamptz [not null]
  deleted_at timestamptz
}

Table daily_checkins {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  local_date date [not null]
  timezone varchar(64) [not null]
  mood_code varchar(32)
  mood_score numeric(3,1)
  stress_score numeric(3,1)
  energy_score numeric(3,1)
  sleep_minutes smallint
  encrypted_note bytea
  note_iv bytea
  note_wrapped_key bytea
  note_key_version varchar(32)
  source varchar(24) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null, default: 0]

  indexes {
    (user_id, local_date) [unique]
  }
}

Table checkin_activities {
  id uuid [pk]
  checkin_id uuid [not null, ref: > daily_checkins.id]
  activity_code varchar(40) [not null]
  duration_minutes smallint
  intensity varchar(16)
  created_at timestamptz [not null]

  indexes {
    (checkin_id, activity_code) [unique]
  }
}

Table ai_analyses {
  id uuid [pk]
  journal_entry_id uuid [not null, ref: > journal_entries.id]
  user_id uuid [not null, ref: > users.id]
  content_version integer [not null]
  analysis_version integer [not null]
  status varchar(24) [not null]
  sentiment_label varchar(24)
  sentiment_score numeric(6,5)
  encrypted_output bytea
  output_iv bytea
  wrapped_data_key bytea
  encryption_key_version varchar(32)
  output_schema_version smallint [not null]
  provider varchar(40) [not null]
  model varchar(120) [not null]
  model_version varchar(120)
  prompt_template_version varchar(40) [not null]
  safety_policy_version varchar(40) [not null]
  started_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (journal_entry_id, content_version, analysis_version) [unique]
  }
}

Ref: journal_entries.latest_analysis_id > ai_analyses.id

Table analysis_emotions {
  analysis_id uuid [not null, ref: > ai_analyses.id]
  emotion_code varchar(32) [not null]
  score numeric(6,5) [not null]
  rank smallint [not null]

  indexes {
    (analysis_id, emotion_code) [pk]
  }
}

Table analysis_topics {
  id uuid [pk]
  analysis_id uuid [not null, ref: > ai_analyses.id]
  topic_code varchar(48) [not null]
  score numeric(6,5) [not null]
  rank smallint [not null]
}

Table safety_events {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  subject_ref bytea [not null]
  journal_entry_id uuid [ref: > journal_entries.id]
  risk_level varchar(16) [not null]
  decision varchar(32) [not null]
  rule_version varchar(40)
  classifier varchar(80)
  classifier_version varchar(80)
  policy_version varchar(40) [not null]
  confidence numeric(6,5)
  resource_set_version varchar(40)
  created_at timestamptz [not null]
}

Table safety_policy_versions {
  id uuid [pk]
  version varchar(40) [not null, unique]
  status varchar(24) [not null]
  config jsonb [not null]
  approved_by uuid [ref: > users.id]
  approved_at timestamptz
  effective_from timestamptz
  effective_to timestamptz
  created_at timestamptz [not null]
}

Table safety_resources {
  id uuid [pk]
  locale varchar(10) [not null]
  country_code varchar(2) [not null, note: 'Exactly two characters; checked in V7']
  resource_type varchar(32) [not null]
  name varchar(200) [not null]
  contact_value varchar(300)
  description text
  source_url text
  verified_at timestamptz
  status varchar(24) [not null]
  version integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table ai_jobs {
  id uuid [pk]
  job_type varchar(40) [not null]
  aggregate_type varchar(40) [not null]
  aggregate_id uuid [not null]
  user_id uuid [ref: > users.id]
  status varchar(24) [not null]
  priority smallint [not null, default: 100]
  attempt integer [not null, default: 0]
  max_attempts integer [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  locked_by varchar(120)
  lease_expires_at timestamptz
  idempotency_key varchar(160) [not null, unique]
  payload jsonb [not null]
  payload_version smallint [not null]
  last_error_code varchar(80)
  last_error_summary varchar(500)
  created_at timestamptz [not null]
  started_at timestamptz
  finished_at timestamptz
}

Table insights {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  insight_type varchar(40) [not null]
  period_start date [not null]
  period_end date [not null]
  timezone varchar(64) [not null]
  status varchar(24) [not null]
  direction varchar(16)
  strength numeric(6,5)
  sample_size integer [not null]
  algorithm_version varchar(40) [not null]
  metrics_snapshot jsonb [not null]
  encrypted_narrative bytea
  narrative_iv bytea
  narrative_wrapped_key bytea
  narrative_key_version varchar(32)
  generated_by varchar(24) [not null]
  created_at timestamptz [not null]
  superseded_at timestamptz

  indexes {
    (user_id, insight_type, period_start, period_end, algorithm_version) [unique]
  }
}

Table insight_evidence {
  id uuid [pk]
  insight_id uuid [not null, ref: > insights.id]
  source_type varchar(32) [not null]
  source_id uuid
  evidence_date date [not null]
  metric_name varchar(48) [not null]
  metric_value numeric(12,4)
  weight numeric(6,5)
  metadata jsonb [not null]
  created_at timestamptz [not null]
}

Table reports {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  report_type varchar(16) [not null]
  period_start date [not null]
  period_end date [not null]
  timezone varchar(64) [not null]
  version integer [not null]
  status varchar(24) [not null]
  sample_size integer [not null]
  metrics_snapshot jsonb [not null]
  encrypted_narrative bytea
  narrative_iv bytea
  narrative_wrapped_key bytea
  narrative_key_version varchar(32)
  generated_by varchar(24) [not null]
  model varchar(120)
  prompt_template_version varchar(40)
  safety_policy_version varchar(40)
  attempt integer [not null, default: 0]
  available_at timestamptz [not null]
  locked_at timestamptz
  locked_by varchar(120)
  lease_expires_at timestamptz
  last_error_code varchar(80)
  created_at timestamptz [not null]
  completed_at timestamptz

  indexes {
    (user_id, report_type, period_start, version) [unique]
  }
}

Table report_evidence {
  id uuid [pk]
  report_id uuid [not null, ref: > reports.id]
  insight_id uuid [ref: > insights.id]
  source_type varchar(32) [not null]
  source_id uuid
  evidence_date date [not null]
  metric_name varchar(48) [not null]
  metric_value numeric(12,4)
  metadata jsonb [not null]
  created_at timestamptz [not null]
}

Table selfcare_goals {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  category varchar(32) [not null]
  encrypted_title bytea [not null]
  encrypted_description bytea
  encryption_key_version varchar(32) [not null]
  status varchar(24) [not null]
  start_date date
  target_date date
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  completed_at timestamptz
  row_version bigint [not null, default: 0]
}

Table habits {
  id uuid [pk]
  goal_id uuid [not null, ref: > selfcare_goals.id]
  user_id uuid [not null, ref: > users.id]
  encrypted_title bytea [not null]
  encryption_key_version varchar(32) [not null]
  target_value numeric(10,2)
  unit varchar(32)
  frequency_type varchar(24) [not null]
  frequency_config jsonb [not null]
  status varchar(24) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null, default: 0]
}

Table habit_completions {
  id uuid [pk]
  habit_id uuid [not null, ref: > habits.id]
  user_id uuid [not null, ref: > users.id]
  local_date date [not null]
  value numeric(10,2) [not null]
  source varchar(24) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (habit_id, local_date) [unique]
  }
}

Table knowledge_items {
  id uuid [pk]
  slug varchar(160) [not null, unique]
  topic_code varchar(48) [not null]
  locale varchar(10) [not null]
  source_name varchar(240) [not null]
  source_url text
  status varchar(24) [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table knowledge_versions {
  id uuid [pk]
  item_id uuid [not null, ref: > knowledge_items.id]
  version integer [not null]
  title varchar(300) [not null]
  content text [not null]
  content_sha256 bytea [not null]
  status varchar(24) [not null]
  created_by uuid [ref: > users.id]
  approved_by uuid [ref: > users.id]
  approved_at timestamptz
  effective_from timestamptz
  effective_to timestamptz
  created_at timestamptz [not null]

  indexes {
    (item_id, version) [unique]
  }
}

Table knowledge_chunks {
  id uuid [pk]
  knowledge_version_id uuid [not null, ref: > knowledge_versions.id]
  chunk_index integer [not null]
  content text [not null]
  token_count integer [not null]
  metadata jsonb
  created_at timestamptz [not null]

  indexes {
    (knowledge_version_id, chunk_index) [unique]
  }
}

Table knowledge_embeddings {
  id uuid [pk]
  chunk_id uuid [not null, ref: > knowledge_chunks.id]
  provider varchar(40) [not null]
  model varchar(120) [not null]
  model_version varchar(120) [not null]
  dimensions integer [not null]
  embedding vector [not null]
  created_at timestamptz [not null]

  indexes {
    (chunk_id, provider, model, model_version) [unique]
  }
}

Table outbox_events {
  id uuid [pk]
  aggregate_type varchar(40) [not null]
  aggregate_id uuid [not null]
  event_type varchar(120) [not null]
  event_version smallint [not null]
  payload jsonb [not null]
  status varchar(24) [not null]
  attempt integer [not null, default: 0]
  available_at timestamptz [not null]
  locked_at timestamptz
  locked_by varchar(120)
  lease_expires_at timestamptz
  last_error_code varchar(80)
  created_at timestamptz [not null]
  published_at timestamptz
}

Table idempotency_keys {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  operation varchar(80) [not null]
  idempotency_key varchar(160) [not null]
  request_hash bytea [not null]
  response_status integer
  response_reference uuid
  state varchar(24) [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  completed_at timestamptz

  indexes {
    (user_id, operation, idempotency_key) [unique]
  }
}

Table audit_logs {
  id uuid [pk]
  actor_user_id uuid [ref: > users.id]
  actor_type varchar(24) [not null]
  action varchar(120) [not null]
  target_type varchar(60) [not null]
  target_id uuid
  reason_code varchar(60)
  safe_metadata jsonb
  trace_id varchar(64)
  occurred_at timestamptz [not null]
}

Table export_requests {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  format varchar(16) [not null]
  status varchar(24) [not null]
  scope jsonb [not null]
  storage_key varchar(512)
  file_sha256 bytea
  expires_at timestamptz
  attempt integer [not null, default: 0]
  created_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
}

Table deletion_requests {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  status varchar(24) [not null]
  requested_at timestamptz [not null]
  scheduled_for timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  checkpoint jsonb
  last_error_code varchar(80)
}
