# Copy this file to .env. Never commit the real .env file.
SPRING_PROFILES_ACTIVE=local
MYLOG_APP_PROFILE=all
MYLOG_SERVER_PORT=8080

MYLOG_DB_NAME=mylog
MYLOG_DB_URL=jdbc:postgresql://localhost:5432/mylog
MYLOG_DB_USERNAME=mylog
MYLOG_DB_PASSWORD=mylog_local_only
MYLOG_DB_POOL_MAX_SIZE=10
MYLOG_DB_POOL_MIN_IDLE=2

MYLOG_REDIS_URL=redis://localhost:6379
MYLOG_ALLOWED_ORIGINS=http://localhost:3000
MYLOG_OPENAPI_ENABLED=true
MYLOG_SWAGGER_UI_ENABLED=true

# Cloudinary is used for private journal images. Keep API_SECRET server-side only.
MYLOG_CLOUDINARY_ENABLED=false
MYLOG_CLOUDINARY_CLOUD_NAME=
MYLOG_CLOUDINARY_API_KEY=
MYLOG_CLOUDINARY_API_SECRET=
MYLOG_CLOUDINARY_FOLDER=mylog

# Add these only when the corresponding adapters are implemented.
# MYLOG_JWT_ISSUER=
# MYLOG_JWT_PUBLIC_KEY=
# MYLOG_ENCRYPTION_MASTER_KEY_REF=
# MYLOG_AI_PROVIDER=
# MYLOG_AI_API_KEY=
