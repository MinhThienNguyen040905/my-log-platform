# Copy this file to .env. Never commit the real .env file.
SPRING_PROFILES_ACTIVE=local
MYLOG_APP_PROFILE=all
MYLOG_SERVER_PORT=8080

MYLOG_DB_NAME=mylog
MYLOG_DB_URL=jdbc:postgresql://localhost:5432/mylog
MYLOG_DB_USERNAME=mylog
MYLOG_DB_PASSWORD=mylog_local_only
MYLOG_DB_POOL_MAX_SIZE=10
MYLOG_DB_POOL_MIN_IDLE=2

MYLOG_REDIS_URL=redis://localhost:6379
MYLOG_ALLOWED_ORIGINS=http://localhost:3000

