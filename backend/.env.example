# Copy this file to .env. Never commit the real .env file.
SPRING_PROFILES_ACTIVE=local
MYLOG_APP_PROFILE=all
MYLOG_SERVER_PORT=8080
MYLOG_JOBS_ENABLED=false
MYLOG_JOBS_POLL_DELAY_MS=2000
# Synthetic analysis only for local/test; never enable with real journal data.
MYLOG_AI_FAKE_ENABLED=false
MYLOG_INSIGHTS_MINIMUM_SAMPLES=7
MYLOG_REPORTS_ENABLED=false
MYLOG_REPORTS_POLL_DELAY_MS=5000
MYLOG_REPORTS_SCHEDULE_DELAY_MS=3600000

MYLOG_DB_NAME=mylog
MYLOG_DB_URL=jdbc:postgresql://localhost:5432/mylog
MYLOG_DB_USERNAME=mylog
MYLOG_DB_PASSWORD=mylog_local_only
MYLOG_DB_POOL_MAX_SIZE=10
MYLOG_DB_POOL_MIN_IDLE=2

MYLOG_REDIS_URL=redis://localhost:6379
MYLOG_ALLOWED_ORIGINS=http://localhost:3000
MYLOG_OPENAPI_ENABLED=true
MYLOG_SWAGGER_UI_ENABLED=true

# Identity keys: local/test can use generated development defaults. Set production keys in secret manager.
MYLOG_JWT_ISSUER=mylog-local
MYLOG_JWT_AUDIENCE=mylog-api
MYLOG_IDENTITY_KEY_VERSION=local-v1
MYLOG_MAIL_FROM=noreply@mylog.local
MYLOG_MAIL_HOST=localhost
MYLOG_MAIL_PORT=1025

# Required outside local/test: supply all keys from a managed secret store.
# MYLOG_IDENTITY_MASTER_KEY=<base64 of 32 random bytes>
# MYLOG_IDENTITY_LOOKUP_KEY=<different base64 of 32 random bytes; keep stable across encryption-key rotation>
# MYLOG_IDENTITY_PREVIOUS_KEYS=<old-version:base64-key,...>
# MYLOG_JWT_KEY_ID=<current signing key ID>
# MYLOG_JWT_PRIVATE_KEY=<PKCS8 PEM with literal \n, or base64 DER>
# MYLOG_JWT_PUBLIC_KEY=<X509 PEM with literal \n, or base64 DER>
# MYLOG_JWT_PREVIOUS_PUBLIC_KEYS=<old-key-id:base64-DER,...>
# MYLOG_MAIL_USERNAME=
# MYLOG_MAIL_PASSWORD=

# Cloudinary is used for private journal images. Keep API_SECRET server-side only.
MYLOG_CLOUDINARY_ENABLED=false
MYLOG_CLOUDINARY_CLOUD_NAME=
MYLOG_CLOUDINARY_API_KEY=
MYLOG_CLOUDINARY_API_SECRET=
MYLOG_CLOUDINARY_FOLDER=mylog

# Add these only when the corresponding adapters are implemented.
# MYLOG_ENCRYPTION_MASTER_KEY_REF=
# MYLOG_AI_PROVIDER=
# MYLOG_AI_API_KEY=
