# Supabase Session pooler (recommended for the long-running API and worker).
# Copy the exact host and username from Supabase Dashboard > Connect > Session pooler.
SPRING_PROFILES_ACTIVE=api,supabase
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=replace_with_your_database_password
DB_SSL_MODE=require
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Optional: use a direct connection for Flyway when the runtime supports IPv6.
# FLYWAY_URL=jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres
# FLYWAY_USERNAME=postgres
# FLYWAY_PASSWORD=replace_with_your_database_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mylog
RABBITMQ_PASSWORD=mylog_local_password

CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080

# Configure only when a production AI adapter is implemented.
AI_PROVIDER=mock
AI_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
