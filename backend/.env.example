# Supabase Session pooler (recommended for the long-running API and worker).
# Copy the exact host and username from Supabase Dashboard > Connect > Session pooler.
# Project ref: wpdsovxhwsmvxshfiuxp (Southeast Asia / Singapore)
SPRING_PROFILES_ACTIVE=api,supabase
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.wpdsovxhwsmvxshfiuxp
DB_PASSWORD=replace_with_your_database_password
DB_SSL_MODE=require
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Base64URL-encoded random key containing at least 32 bytes. Never reuse the example value.
JWT_ISSUER=mylog-backend
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_SIGNING_KEY_BASE64=replace_with_at_least_32_random_bytes_encoded_as_base64url
BCRYPT_STRENGTH=12
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict
TERMS_POLICY_VERSION=1.0
PRIVACY_POLICY_VERSION=1.0

# Optional: use a direct connection for Flyway when the runtime supports IPv6.
# FLYWAY_URL=jdbc:postgresql://db.wpdsovxhwsmvxshfiuxp.supabase.co:5432/postgres
# FLYWAY_USERNAME=postgres
# FLYWAY_PASSWORD=replace_with_your_database_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mylog
RABBITMQ_PASSWORD=mylog_local_password

CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080

# Configure only when a production AI adapter is implemented.
AI_PROVIDER=mock
AI_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Transactional outbox
OUTBOX_SCHEDULING_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL=1s
OUTBOX_CLAIM_LEASE=30s
OUTBOX_CONFIRM_TIMEOUT=5s
OUTBOX_RETRY_BASE_DELAY=2s
OUTBOX_RETRY_MAX_DELAY=5m
